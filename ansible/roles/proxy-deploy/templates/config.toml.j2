# ─── Semantic validation (LLM-based false-positive filter) ───
# Requires Ollama running on localhost:11434 with qwen2.5:0.5b model.
# When enabled, DPI detections are validated by a local LLM before tokenization.
# False positives (code identifiers, documentation) are dropped.
# Fail-open: if Ollama is down, all detections are kept (safe default).
[semantic]
enabled = true
endpoint = "http://localhost:11434"
model = "qwen2.5:0.5b"
timeout_ms = 8000
concurrency = 2
cache_size = 1000
circuit_breaker_failures = 5
circuit_breaker_cooldown_sec = 300