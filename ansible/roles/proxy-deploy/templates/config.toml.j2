mode = "mitm"

[server]
host = "0.0.0.0"
port = {{ proxy_port | default(8443) }}

# ─── Redis (required for vault — reversible ‹KEY_xxx› mapping) ───
# Ensure Redis is configured with persistence:
#   redis-cli CONFIG SET appendonly yes
#   redis-cli CONFIG SET save "900 1 300 10 60 10000"
[redis]
url = "redis://:{{ redis_pass | default('') }}@{{ redis_host | default('127.0.0.1') }}:{{ redis_port | default(6379) }}"

# ─── Auth: database backend (required for users/audit/billing) ───
# Ensure PostgreSQL backups are configured:
#   pg_dump ai_proxy | gzip > /backup/ai_proxy_$(date +%Y%m%d).sql.gz
[auth]
backend = "db"
require_auth = true

[auth.db]
url = "postgres://{{ db_user | default('ai_proxy') }}:{{ db_pass | default('changeme') }}@{{ db_host | default('127.0.0.1') }}:{{ db_port | default(5432) }}/{{ db_name | default('ai_proxy') }}"

[auth.jwt]
secret = "{{ jwt_secret | default('change-me-in-production') }}"
token_ttl_days = 30

[auth.admin]
bind = "0.0.0.0:{{ admin_port | default(8444) }}"

